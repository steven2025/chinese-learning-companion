            "keywords": [{"hanzi": "知道", "pinyin": "zhīdào", "meaning": {"en": "to know about"}}, {"hanzi": "中国人", "pinyin": "Zhōngguórén", "meaning": {"en": "Chinese person"}}],
            "tip": {"zh-CN": "先说姓，再说完整姓名；不知道汉字时可以选择词卡或用语音回答。", "en": "Give the surname first, then the full name. Use cards or speech if typing Chinese is difficult."},
