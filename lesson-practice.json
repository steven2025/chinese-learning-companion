            "instruction": {"zh-CN": "根据上下文，从词句卡中选择合适的答案。", "en": "Use the context to choose the best answer card."},
            "keywords": [{"hanzi": "贵姓", "pinyin": "guìxìng", "meaning": {"en": "your honourable surname"}}, {"hanzi": "认识", "pinyin": "rènshi", "meaning": {"en": "to meet / know"}}],
            "tip": {"zh-CN": "先看前一句问了什么，再选择能直接回答的句子。", "en": "Read the preceding question and choose the sentence that answers it directly."},
            "frame": {"zh-CN": "你____？—我____。", "en": "You ____? — I ____."}
