          "answerCards": ["我姓王。", "我叫王小明。", "你呢？", "认识你很高兴。"],
          "support": {
            "instruction": {"zh-CN": "和同学互相询问姓和名字。", "en": "Ask a classmate's surname and given name."},
            "keywords": [{"hanzi": "姓", "pinyin": "xìng", "meaning": {"en": "surname"}}, {"hanzi": "名字", "pinyin": "míngzi", "meaning": {"en": "given name / name"}}],
            "tip": {"zh-CN": "“您贵姓？”更礼貌；同学之间可以说“你姓什么？”。", "en": "Nín guìxìng? is more polite; classmates may use Nǐ xìng shénme?"},
            "frame": {"zh-CN": "我姓____。我叫____。", "en": "My surname is ____. My name is ____."}
          },
          "title": {
            "zh-CN": "互相询问姓和名字",
            "en": "Ask each other's surnames and given names"
          },
          "prompts": [
            {
              "role": "A",
              "hanzi": "你姓什么？",
              "pinyin": "Nǐ xìng shénme?"
            },
            {
              "role": "B",
              "hanzi": "我姓______。",
              "pinyin": "Wǒ xìng ______."
            },
