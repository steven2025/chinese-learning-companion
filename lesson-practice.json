        "zh-CN": "二、综合练习",
        "en": "II. Comprehensive Exercises"
      },
      "items": [
        {
          "id": "pinyin-and-tone",
          "type": "pinyinTone",
          "support": {
            "instruction": {"zh-CN": "给汉字选择正确的拼音和声调。", "en": "Choose the correct pinyin syllable and tone for each character."},
            "keywords": [{"hanzi": "拼音", "pinyin": "pīnyīn", "meaning": {"en": "pinyin"}}, {"hanzi": "声调", "pinyin": "shēngdiào", "meaning": {"en": "tone"}}],
            "tip": {"zh-CN": "先听完整音节，再判断声调的高低变化。", "en": "Listen to the complete syllable before identifying its pitch movement."},
            "frame": {"zh-CN": "选择音节，再选择轻声或1—4声。", "en": "Choose a syllable, then the neutral tone or tones 1–4."}
          },
          "title": {
            "zh-CN": "写出汉字的拼音",
            "en": "Write the pinyin syllables"
          },
          "instruction": {
            "zh-CN": "先输入不带声调符号的拼音，再选择轻声或1—4声，最后确认答案。",
            "en": "Type the pinyin without a tone mark, select the neutral tone or tones 1–4, then check your answer."
          },
          "items": [
            {
              "id": "pinyin-01",
