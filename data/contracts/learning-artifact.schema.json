{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanyu-banxue.local/schemas/learning-artifact.schema.json",
  "title": "汉语伴学学习成果记录",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "userId",
    "lessonId",
    "unitType",
    "unitId",
    "createdAt",
    "media",
    "storage",
    "assessments",
    "consent"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactId": { "type": "string", "minLength": 1 },
    "userId": { "type": "string", "minLength": 1 },
    "lessonId": { "type": "string", "minLength": 1 },
    "unitType": {
      "enum": ["sentence", "paragraphReading", "vocabularyWriting", "practiceWriting"]
    },
    "unitId": { "type": "string", "minLength": 1 },
    "referenceText": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "media": {
      "type": "object",
      "required": ["mimeType", "sizeBytes"],
      "properties": {
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["provider", "status", "objectKey", "url"],
      "properties": {
        "provider": { "const": "tencent-cos" },
        "status": {
          "enum": ["local", "uploadPending", "uploaded", "failed"]
        },
        "objectKey": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "status", "mode", "result"],
        "properties": {
          "provider": { "enum": ["tencent-soe", "deepseek"] },
          "status": { "enum": ["pending", "processing", "completed", "failed"] },
          "mode": { "type": "string" },
          "result": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "consent": {
      "type": "object",
      "required": ["uploadAllowed", "consentedAt"],
      "properties": {
        "uploadAllowed": { "type": "boolean" },
        "consentedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
